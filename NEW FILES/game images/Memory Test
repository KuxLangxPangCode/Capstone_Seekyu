<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Seekyu · Short-Term Memory</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    :root { --piece-size: 96px; }
    @media (max-width: 640px) { :root { --piece-size: 68px; } }

    .stage { position: relative; height: clamp(280px, 48vh, 480px); }

    .piece {
      position: absolute; width: var(--piece-size); user-select: none; cursor: default;
      opacity: 0; transform: translate(-50%,-50%) scale(.98);
      transition: left .45s cubic-bezier(.2,.7,.2,1),
                  top  .45s cubic-bezier(.2,.7,.2,1),
                  opacity .25s ease,
                  transform .15s ease;
      image-rendering: pixelated;
    }
    .piece.ready { opacity: 1; transform: translate(-50%,-50%) scale(1); }

    .pixel-ui { font-family: "Press Start 2P", system-ui, sans-serif; }
    .pixel-panel {
      background: linear-gradient(180deg, #f9fcff 0%, #eef7ff 100%);
      border: 4px solid #bae6fd; outline: 2px solid #0ea5e9; border-radius: 12px;
      box-shadow: 0 6px 0 #93c5fd;
    }
    .pixel-title { font-size: 11px; color: #0369a1; }
    .pixel-label { font-size: 10px; color: #0c4a6e; }

    .pixel-btn {
      background: #0ea5e9; border: 4px solid #0369a1; outline: 2px solid #bae6fd; border-radius: 8px;
      padding: 12px 16px; color: #fff; font-size: 10px; line-height: 1;
      transition: transform .05s ease, background .2s ease;
    }
    .pixel-btn:hover { background: #0284c7; transform: translateY(-1px); }
    .pixel-btn:active { transform: translateY(1px); }

    #stage.pixel-stage {
      background: linear-gradient(180deg, #e0f2ff 0%, #f8fcff 100%);
      border: 3px solid #bae6fd; outline: 2px solid #0ea5e9; border-radius: 12px;
      position: relative; overflow: hidden;
    }

    /* Overlay */
    #questionOverlay { position: absolute; inset: 0; display: none; }
    #questionOverlay.active { display: block; }

    .choice-btn {
      background: #fff; border: 3px solid #93c5fd; outline: 2px solid #cfe8ff; border-radius: 10px;
      padding: 8px; font-size: 10px; color: #073b65;
      transition: transform .05s ease, background .15s ease, border-color .15s ease;
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      min-width: 0;
    }
    .choice-btn img { width: 48px; height: 48px; image-rendering: pixelated; }
    @media (min-width: 360px) { .choice-btn img { width: 52px; height: 52px; } }
    @media (min-width: 768px) { .choice-btn img { width: 56px; height: 56px; } }

    .choice-cap{
      display: -webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
      overflow:hidden; text-align:center; line-height:1.15;
      font-size: clamp(9px, 2.9vw, 11px); word-break: break-word; max-width: 9ch;
    }

    .choice-btn:hover { background:#f0f7ff; transform: translateY(-1px); }
    .choice-btn[data-selected="true"] { border-color:#0ea5e9; outline-color:#bde5ff; background:#eaf6ff; }

    .mono { font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 font-[Inter]">
  <!-- Top -->
  <header class="border-b border-slate-200 bg-white">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="h-8 w-8 rounded-lg bg-sky-600 text-white grid place-items-center font-bold">S</div>
        <div class="text-sm font-semibold tracking-tight">Seekyu · Assessment</div>
      </div>
      <div class="text-xs text-slate-500">Scenario: Short-Term Memory</div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <!-- Brief -->
    <section class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
      <h1 class="text-xl md:text-2xl font-semibold tracking-tight">Scenario Brief</h1>
      <p class="mt-1 text-slate-600">
        Press Begin. Five guard items are in the pool. Each round flashes a
        <strong> row of 4 items</strong> for <strong>3 seconds</strong>. One item from the set is missing.
        Choose the missing item and submit. There are <strong>5 rounds</strong>. The timer above tracks your total time.
      </p>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Location</div>
          <div class="text-sm font-medium">HQ Security Desk</div>
        </div>
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Objective</div>
          <div class="text-sm font-medium">Spot the missing gear per round</div>
        </div>
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Guidance</div>
          <div class="text-sm font-medium">Watch the row closely before it hides</div>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <p class="text-slate-600">Begin the scenario to show the row.</p>
        <button id="beginBtn" type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500">
          Begin Scenario
        </button>
      </div>
    </section>

    <!-- Pixel Card -->
    <section class="mt-6 pixel-panel pixel-ui p-5">
      <div class="flex items-center justify-between">
        <h2 class="pixel-title font-bold">MEMORY CHECK</h2>
        <div class="flex items-center gap-4">
          <span class="pixel-label text-sky-700">Time: <span id="pixelTimer" class="mono">00:00</span></span>
          <span id="roundLabel" class="pixel-label">Round 0 of 5</span>
        </div>
      </div>

      <div id="stage" class="stage mt-4 pixel-stage">
        <!-- Flash badge -->
        <div id="flashBadge"
             class="hidden absolute top-3 right-3 pixel-ui text-[10px] bg-white/90 border border-sky-300 rounded-lg px-2 py-1 text-sky-800">
          Flash: <span id="flashLeft" class="mono">3.0</span>s
        </div>

        <!-- Question Overlay -->
        <div id="questionOverlay">
          <div class="absolute inset-0 bg-white/70 backdrop-blur-[2px]"></div>
          <div class="relative h-full w-full flex items-center justify-center p-3 sm:p-4">
            <div class="max-w-xl w-full bg-white rounded-2xl border border-slate-200 shadow-md p-3 sm:p-4">
              <h3 class="text-sm sm:text-base md:text-lg font-semibold mb-3 text-center sm:text-left">Which item was missing?</h3>
              <div id="choicesEl" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2 mb-3"></div>
              <div class="flex items-center justify-end">
                <button id="submitBtn" class="pixel-btn disabled:opacity-40 disabled:cursor-not-allowed" disabled>SUBMIT</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-4 flex items-center gap-3">
        <button id="nextBtn" class="hidden pixel-btn bg-sky-600 border-[#024e7a] outline-[#cbe7ff] hover:bg-sky-700">
          NEXT
        </button>
        <div id="score" class="hidden pixel-label" aria-live="polite"></div>
      </div>

      <p class="mt-3 pixel-label">Tip: Standard security gear appears in this test.</p>
    </section>

    <!-- Outcome -->
    <section id="outcome" class="hidden mt-6 bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
      <div class="flex items-center gap-2">
        <div id="outcomeDot" class="h-2.5 w-2.5 rounded-full bg-slate-300"></div>
        <h3 class="text-base font-semibold">Scenario Outcome</h3>
      </div>
      <p id="outcomeText" class="mt-2 text-slate-700 text-sm"></p>
    </section>
  </main>

  <script>
    // ---------- Scoring thresholds to match Bag Inspection ----------
    const SCORING = { PASS_PCT: 80, CONDITIONAL_PCT: 60 };

    // Items (replace sprites as needed)
    const ITEMS = [
      { key: 'radio',      label: 'Radio',      src: 'memory/radio.png' },
      { key: 'flashlight', label: 'Flashlight', src: 'memory/flashlight.png' },
      { key: 'scanner',    label: 'Scanner',    src: 'memory/scanner.png' },
      { key: 'whistle',    label: 'Whistle',    src: 'memory/whistle.png' },
      { key: 'logbook',    label: 'Logbook',    src: 'memory/logbook.png' },
    ];

    const FLASH_SECONDS = 3.0;
    const TOTAL_ROUNDS  = 5;
    const AUTONEXT_DELAY_MS = 450;

    // Elements
    const beginBtn = document.getElementById('beginBtn');
    const stage = document.getElementById('stage');
    const pixelTimer = document.getElementById('pixelTimer');
    const roundLabel = document.getElementById('roundLabel');
    const flashBadge = document.getElementById('flashBadge');
    const flashLeftEl = document.getElementById('flashLeft');
    const questionOverlay = document.getElementById('questionOverlay');
    const choicesEl = document.getElementById('choicesEl');
    const submitBtn = document.getElementById('submitBtn');
    const nextBtn = document.getElementById('nextBtn');
    const outcome = document.getElementById('outcome');
    const outcomeDot = document.getElementById('outcomeDot');
    const outcomeText = document.getElementById('outcomeText');

    // HUD timer
    let hudTicker = null, hudStart = 0;
    function startHud() {
      hudStart = performance.now();
      stopHud();
      hudTicker = setInterval(() => {
        const ms = performance.now() - hudStart;
        const s  = Math.floor(ms / 1000);
        const mm = String(Math.floor(s / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        pixelTimer.textContent = `${mm}:${ss}`;
      }, 200);
    }
    function stopHud() { if (hudTicker) clearInterval(hudTicker); }

    // State
    let round = 0;
    let score = 0;
    let currentMissing = null;
    let selectedKey = null;
    let flashTicker = null;
    const history = []; // {round, missing, answer, correct, hudStamp}

    // Helpers
    function shuffle(a) {
      const arr = [...a];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }
    function labelOf(key) { return ITEMS.find(i => i.key === key)?.label || ''; }
    function clearStage() { stage.querySelectorAll('.piece').forEach(n => n.remove()); }

    // Row layout (4 visible)
    function layoutRow(itemsToShow) {
      const rect = stage.getBoundingClientRect();
      const y = rect.height * 0.5;
      const n = itemsToShow.length;
      const pad = Math.max(16, rect.width * 0.08);
      const usable = Math.max(120, rect.width - pad * 2);
      const step = usable / (n + 1);
      for (let i = 0; i < n; i++) {
        const x = pad + step * (i + 1);
        renderPiece(itemsToShow[i], x, y);
      }
    }

    function renderPiece(item, x, y) {
      const el = document.createElement('img');
      el.src = item.src; el.alt = item.label;
      el.className = 'piece';
      el.style.left = (stage.clientWidth / 2) + 'px';
      el.style.top  = (stage.clientHeight / 2) + 'px';
      stage.appendChild(el);
      requestAnimationFrame(() => {
        el.style.left = x + 'px';
        el.style.top  = y + 'px';
        el.classList.add('ready');
      });
    }

    // Build distinct missing list
    const missingOrder = shuffle(ITEMS).slice(0, TOTAL_ROUNDS).map(i => i.key);

    function startRound() {
      round += 1;
      roundLabel.textContent = `Round ${round} of ${TOTAL_ROUNDS}`;
      nextBtn.classList.add('hidden');
      outcome.classList.add('hidden');
      questionOverlay.classList.remove('active');
      submitBtn.textContent = 'SUBMIT';
      submitBtn.disabled = true;

      currentMissing = ITEMS.find(i => i.key === missingOrder[round - 1]) || shuffle(ITEMS)[0];

      const toShow = ITEMS.filter(i => i.key !== currentMissing.key);
      clearStage();
      layoutRow(toShow);

      // countdown
      let left = FLASH_SECONDS;
      flashBadge.classList.remove('hidden');
      flashLeftEl.textContent = left.toFixed(1);
      if (flashTicker) clearInterval(flashTicker);
      flashTicker = setInterval(() => {
        left = Math.max(0, left - 0.1);
        flashLeftEl.textContent = left.toFixed(1);
        if (left <= 0) {
          clearInterval(flashTicker);
          showQuestion();
        }
      }, 100);
    }

    function showQuestion() {
      flashBadge.classList.add('hidden');
      clearStage();

      questionOverlay.classList.add('active');
      choicesEl.innerHTML = '';
      selectedKey = null;

      shuffle(ITEMS).forEach(it => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'choice-btn pixel-ui';
        btn.dataset.key = it.key;

        const img = document.createElement('img');
        img.src = it.src; img.alt = it.label; img.draggable = false;

        const cap = document.createElement('span');
        cap.className = 'choice-cap';
        cap.textContent = it.label;
        cap.title = it.label;

        btn.appendChild(img);
        btn.appendChild(cap);

        btn.addEventListener('click', () => {
          selectedKey = it.key;
          [...choicesEl.children].forEach(c => c.dataset.selected = 'false');
          btn.dataset.selected = 'true';
          submitBtn.disabled = false;
        });
        choicesEl.appendChild(btn);
      });
    }

    function finishRound() {
      questionOverlay.classList.remove('active');

      const correct = selectedKey === currentMissing.key;
      if (correct) score += 1;

      const hudStamp = pixelTimer.textContent.trim();
      history.push({ round, missing: currentMissing.key, answer: selectedKey, correct, hudStamp });
    }

    function finalizeSession() {
      stopHud();

      const wrong = TOTAL_ROUNDS - score;
      const pct = Math.round((score / TOTAL_ROUNDS) * 100);

      let status = 'Fail', dot = 'bg-rose-500';
      if (pct >= SCORING.PASS_PCT) { status = 'Pass'; dot = 'bg-emerald-500'; }
      else if (pct >= SCORING.CONDITIONAL_PCT) { status = 'Conditional'; dot = 'bg-amber-500'; }

      outcome.classList.remove('hidden');
      outcomeDot.className = `h-2.5 w-2.5 rounded-full ${dot}`;
      outcomeText.innerHTML = `Result: <strong>${status}</strong> • Score: ${score}/${TOTAL_ROUNDS} (${pct}%) • Wrong: ${wrong} • Time: ${pixelTimer.textContent}`;

      nextBtn.classList.remove('hidden');
      nextBtn.onclick = () => { window.location.href = 'index.html'; }; // change path if needed

      // Standardized event payload
      window.dispatchEvent(new CustomEvent('seekyu:memory-finished', {
        detail: { score, total: TOTAL_ROUNDS, wrong, pct, totalTime: pixelTimer.textContent, result: status, history }
      }));
    }

    // Controls
    beginBtn.addEventListener('click', () => {
      beginBtn.disabled = true;
      beginBtn.classList.add('opacity-60','cursor-not-allowed');
      startHud();
      startRound();
    });

    submitBtn.addEventListener('click', () => {
      submitBtn.disabled = true;
      submitBtn.textContent = 'SUBMITTED';
      finishRound();

      if (round < TOTAL_ROUNDS) {
        setTimeout(() => { startRound(); }, AUTONEXT_DELAY_MS);
      } else {
        finalizeSession();
      }
    });
  </script>
</body>
</html>
