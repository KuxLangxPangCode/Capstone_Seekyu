<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Seekyu · Document Sorting</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    .stage { position: relative; height: 480px; }

    .pixel-ui { font-family: "Press Start 2P", system-ui, sans-serif; }
    .pixel-panel {
      background: linear-gradient(180deg, #f9fcff 0%, #eef7ff 100%);
      border: 4px solid #bae6fd; outline: 2px solid #0ea5e9; border-radius: 12px;
      box-shadow: 0 6px 0 #93c5fd; padding: 20px;
    }
    .pixel-title { font-size: 11px; color: #0369a1; letter-spacing: 0; }
    .pixel-label { font-size: 10px; color: #0c4a6e; letter-spacing: 0; }

    .pixel-btn {
      background: #0ea5e9; border: 4px solid #0369a1; outline: 2px solid #bae6fd; border-radius: 8px;
      padding: 10px 14px; color: #fff; font-size: 10px; line-height: 1;
      transition: transform .05s ease, background .2s ease;
    }
    .pixel-btn:hover { background: #0284c7; transform: translateY(-1px); }
    .pixel-btn:active { transform: translateY(1px); }

    #stage.pixel-stage {
      background: linear-gradient(180deg, #e0f2ff 0%, #f8fcff 100%);
      border: 3px solid #bae6fd; outline: 2px solid #0ea5e9; border-radius: 12px;
      position: relative; overflow: hidden;
    }

    /* Draggable docs */
    .doc {
      position: absolute; width: 84px; user-select: none; cursor: grab;
      opacity: 0; transform: translate(-50%,-50%) scale(.96);
      transition: left .45s cubic-bezier(.2,.7,.2,1), top .45s cubic-bezier(.2,.7,.2,1), opacity .25s ease, transform .15s ease;
      image-rendering: pixelated;
      background: #fff; border: 2px solid #93c5fd; border-radius: 8px; padding: 6px;
    }
    .doc.ready { opacity: 1; transform: translate(-50%,-50%) scale(1); }
    .doc:active { cursor: grabbing; }

    /* Folder row (droppable bins) */
    .folders {
      position: absolute; left: 0; right: 0; bottom: 8px;
      display: grid; grid-template-columns: repeat(3,1fr); gap: 10px;
      padding: 10px; pointer-events: none;
    }
    .folder {
      pointer-events: auto;
      background: #ffffffd6; border: 3px solid #bae6fd; outline: 2px solid #0ea5e9; border-radius: 12px;
      min-height: 110px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 6px;
      padding: 8px 8px 10px;
    }
    .folder img { width: 48px; height: 48px; image-rendering: pixelated; }
    .folder .label { font-size: 10px; color: #073b65; text-align: center; }

    .folder.drop-focus { outline-color: #0284c7; box-shadow: inset 0 0 0 2px #0ea5e9; background: #f0f9ff; }
    .folder-grid {
      width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); gap: 6px;
    }

    /* Doc appearance once inside a folder */
    .in-bin {
      position: static !important; width: 40px !important; height: 40px !important;
      padding: 2px !important; border-radius: 6px; border: 2px solid #93c5fd; background: #fff;
      transform: none !important; cursor: grab;
    }

    /* Progress pill */
    .pill {
      position: absolute; top: 8px; right: 8px; background: #ffffffd9;
      border: 2px solid #93c5fd; border-radius: 999px; padding: 4px 10px; font-size: 10px;
    }

    /* Mobile tweaks */
    @media (max-width: 420px) {
      .doc { width: 76px; }
      .folder img { width: 40px; height: 40px; }
      .folder .label { font-size: 9px; }
      .folder { min-height: 100px; }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 font-[Inter]">
  <!-- Top -->
  <header class="border-b border-slate-200 bg-white">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="h-8 w-8 rounded-lg bg-sky-600 text-white grid place-items-center font-bold">S</div>
        <div class="text-sm font-semibold tracking-tight">Seekyu · Assessment</div>
      </div>
      <div class="text-xs text-slate-500">Scenario: Document Sorting</div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <!-- Scenario Brief -->
    <section class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
      <h1 class="text-xl md:text-2xl font-semibold tracking-tight">Scenario Brief</h1>
      <p class="mt-1 text-slate-600">
        Drag each document into its correct folder. Categories: <strong>Incident Report</strong>, <strong>Applicant Form</strong>, <strong>Patrol Log</strong>.
        Earn <strong>+10 pts</strong> per correct file. A perfect score unlocks the <strong>"Office Organizer"</strong> badge.
      </p>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Location</div>
          <div class="text-sm font-medium">Security Office</div>
        </div>
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Objective</div>
          <div class="text-sm font-medium">Sort all documents accurately</div>
        </div>
        <div class="rounded-xl border border-slate-200 p-3">
          <div class="text-xs text-slate-500">Guidance</div>
          <div class="text-sm font-medium">Match document type to the right folder</div>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <p class="text-slate-600">Press Begin to reveal the desk and folders.</p>
        <button id="beginBtn" type="button"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500">
          Begin Scenario
        </button>
      </div>
    </section>

    <!-- Pixel Interaction Card -->
    <section class="mt-6 pixel-panel pixel-ui">
      <div class="flex items-center justify-between">
        <h2 class="pixel-title font-bold">DOCUMENT SORTING</h2>
        <div class="flex items-center gap-4">
          <span class="pixel-label text-sky-700">Time: <span id="pixelTimer">00:00</span></span>
          <span id="roundLabel" class="pixel-label">Sort all items</span>
        </div>
      </div>

      <!-- Stage -->
      <div id="stage" class="stage mt-4 pixel-stage">
        <div id="progressPill" class="pill pixel-ui hidden" aria-live="polite">Filed 0 / 0</div>

        <!-- Folder Row -->
        <div id="foldersRow" class="folders hidden">
          <!-- Folders injected here -->
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-4 flex items-center gap-3">
        <button id="submitBtn" class="pixel-btn hidden">SUBMIT</button>
        <button id="nextBtn" class="pixel-btn ml-auto hidden bg-sky-600 border-[#024e7a] outline-[#cbe7ff] hover:bg-sky-700">NEXT</button>
        <div id="score" class="hidden pixel-label" aria-live="polite"></div>
      </div>

      <p class="mt-3 pixel-label">Tip: Titles and icons hint which folder is right.</p>
    </section>

    <!-- Outcome -->
    <section id="outcome" class="hidden mt-6 bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
      <div class="flex items-center gap-2">
        <div id="outcomeDot" class="h-2.5 w-2.5 rounded-full bg-slate-300"></div>
        <h3 class="text-base font-semibold">Scenario Outcome</h3>
      </div>
      <p id="outcomeText" class="mt-2 text-slate-700 text-sm"></p>
    </section>
  </main>

  <script>
    // --------- Config ---------
    const POINTS_PER_CORRECT = 10;
    const DOCS = [
      { id: 'ir1', kind: 'incident',   label: 'Incident Report', src: 'images/sorting/doc-incident-1.png' },
      { id: 'ir2', kind: 'incident',   label: 'Incident Report', src: 'images/sorting/doc-incident-2.png' },
      { id: 'ap1', kind: 'application',label: 'Applicant Form',  src: 'images/sorting/doc-application-1.png' },
      { id: 'ap2', kind: 'application',label: 'Applicant Form',  src: 'images/sorting/doc-application-2.png' },
      { id: 'pl1', kind: 'patrol',     label: 'Patrol Log',      src: 'images/sorting/doc-patrol-1.png' },
      { id: 'pl2', kind: 'patrol',     label: 'Patrol Log',      src: 'images/sorting/doc-patrol-2.png' },
    ];
    const FOLDERS = [
      { kind: 'incident',    label: 'Incidents',    icon: 'images/sorting/folder-incident.png' },
      { kind: 'application', label: 'Applications', icon: 'images/sorting/folder-application.png' },
      { kind: 'patrol',      label: 'Patrol Logs',  icon: 'images/sorting/folder-patrol.png' },
    ];
    const TOTAL = DOCS.length;

    // --------- Elements ---------
    const beginBtn = document.getElementById('beginBtn');
    const stage = document.getElementById('stage');
    const foldersRow = document.getElementById('foldersRow');
    const progressPill = document.getElementById('progressPill');

    const pixelTimer = document.getElementById('pixelTimer');
    const submitBtn = document.getElementById('submitBtn');
    const nextBtn = document.getElementById('nextBtn');
    const scoreDiv = document.getElementById('score');
    const outcome = document.getElementById('outcome');
    const outcomeDot = document.getElementById('outcomeDot');
    const outcomeText = document.getElementById('outcomeText');

    // --------- Timer ---------
    let hudTicker = null;
    function startHud() {
      const t0 = performance.now();
      stopHud();
      hudTicker = setInterval(() => {
        const s = Math.floor((performance.now() - t0) / 1000);
        const mm = String(Math.floor(s / 60)).padStart(2, '0');
        const ss = String(s % 60).padStart(2, '0');
        pixelTimer.textContent = `${mm}:${ss}`;
      }, 200);
    }
    function stopHud() {
      if (hudTicker) clearInterval(hudTicker);
      hudTicker = null;
    }

    // Prevent the browser from opening the image if dropped on the stage
    stage.addEventListener('dragover', e => e.preventDefault());
    stage.addEventListener('drop', e => e.preventDefault());

    // --------- State ---------
    const placed = new Map(); // docId -> folderKind
    let finished = false;

    // --------- Helpers ---------
    function shuffle(a){
      const arr = [...a];
      for (let i = arr.length - 1; i > 0; i--){
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function updateProgress(){
      const count = placed.size;
      progressPill.textContent = `Filed ${count} / ${TOTAL}`;
      if (count >= TOTAL) {
        submitBtn.classList.remove('hidden');
      } else {
        submitBtn.classList.add('hidden');
      }
    }

    function renderFolders(){
      foldersRow.innerHTML = '';
      FOLDERS.forEach(f => {
        const bin = document.createElement('div');
        bin.className = 'folder';
        bin.dataset.kind = f.kind;
        bin.innerHTML = `
          <img src="${f.icon}" alt="${f.label}" draggable="false" />
          <div class="label pixel-ui">${f.label}</div>
          <div class="folder-grid" aria-label="${f.label} dropzone"></div>
        `;
        // DnD events
        bin.addEventListener('dragover', e => { if (!finished){ e.preventDefault(); bin.classList.add('drop-focus'); }});
        bin.addEventListener('dragleave', () => bin.classList.remove('drop-focus'));
        bin.addEventListener('drop', e => {
          if (finished) return;
          e.preventDefault();
          bin.classList.remove('drop-focus');

          const id = e.dataTransfer.getData('id');
          const el = document.getElementById(id);
          if (!el) return;

          // Move into bin
          el.classList.add('in-bin');
          el.style.left = '0px'; el.style.top = '0px';
          bin.querySelector('.folder-grid').appendChild(el);

          placed.set(id, bin.dataset.kind);
          updateProgress();
        });
        foldersRow.appendChild(bin);
      });
    }

    function spawnDocs(){
      const rect = stage.getBoundingClientRect();
      const cx = rect.width / 2;
      const cy = rect.height * 0.35;

      const docs = shuffle(DOCS);
      const radius = Math.min(rect.width, rect.height) * 0.35;
      const jitter = 16;

      docs.forEach((d, i) => {
        const el = document.createElement('img');
        el.id = d.id;
        el.src = d.src;
        el.alt = d.label;
        el.className = 'doc';
        el.setAttribute('draggable', true);
        el.dataset.kind = d.kind;
        // center spawn
        el.style.left = cx + 'px';
        el.style.top  = cy + 'px';

        stage.appendChild(el);

        // enable drag
        el.addEventListener('dragstart', e => {
          if (finished) { e.preventDefault(); return; }
          e.dataTransfer.setData('id', d.id);
          e.dataTransfer.effectAllowed = 'move';
        });

        // scatter
        const ang = (i * (2*Math.PI/docs.length)) + (Math.random()*0.6 - 0.3);
        const r = radius + (Math.random()*2 - 1)*jitter;
        const tx = cx + Math.cos(ang)*r;
        const ty = cy + Math.sin(ang)*r;

        requestAnimationFrame(() => {
          el.style.left = Math.max(60, Math.min(rect.width - 60, tx)) + 'px';
          el.style.top  = Math.max(60, Math.min(rect.height - 150, ty)) + 'px';
          el.classList.add('ready');
        });
      });
    }

    function scoreIt(){
      const correct = DOCS.filter(d => placed.get(d.id) === d.kind).length;
      const wrong = TOTAL - correct;
      const points = correct * POINTS_PER_CORRECT;
      return { correct, wrong, points };
    }

    function finalize(){
      finished = true;
      stopHud();

      const { correct, wrong, points } = scoreIt();
      const totalPoints = TOTAL * POINTS_PER_CORRECT;
      const badge = (correct === TOTAL) ? 'Office Organizer' : null;

      // lock DnD
      document.querySelectorAll('.doc').forEach(el => el.setAttribute('draggable', 'false'));

      // summary UI
      scoreDiv.classList.remove('hidden');
      scoreDiv.textContent = `Score: ${points}/${totalPoints} • Correct: ${correct}/${TOTAL} • Wrong: ${wrong} • Time: ${pixelTimer.textContent}${badge ? ' • Badge: ' + badge : ''}`;

      outcome.classList.remove('hidden');
      outcomeDot.className = `h-2.5 w-2.5 rounded-full ${correct === TOTAL ? 'bg-emerald-500' : (correct >= Math.ceil(TOTAL*0.6) ? 'bg-amber-500' : 'bg-rose-500')}`;
      outcomeText.textContent = badge
        ? `Perfect! You earned the "${badge}" badge.`
        : 'Good try, review and aim for a perfect file next time.';

      // NEXT
      nextBtn.classList.remove('hidden');
      nextBtn.onclick = () => { window.location.href = 'Memory%20Test.html'; };

      window.dispatchEvent(new CustomEvent('seekyu:sort-finished', {
        detail: {
          correct, wrong, points, totalPoints,
          time: pixelTimer.textContent,
          badge: badge || ''
        }
      }));
    }

    // --------- Controls ---------
    beginBtn.addEventListener('click', () => {
      beginBtn.disabled = true;
      beginBtn.classList.add('opacity-60','cursor-not-allowed');

      // reveal UI
      foldersRow.classList.remove('hidden');
      progressPill.classList.remove('hidden');
      progressPill.textContent = `Filed 0 / ${TOTAL}`;
      startHud();

      renderFolders();
      spawnDocs();
      updateProgress();
    });

    submitBtn.addEventListener('click', finalize);
  </script>
</body>
</html>
